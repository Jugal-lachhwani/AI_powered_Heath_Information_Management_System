# Copy to AI_backend/.env and fill in your own keys. Never commit the real file.

# --- LLM (structuring + clinical extraction) ---
# Providers: gemini | openai | grok | nvidia | groq | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=360
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Speech-to-text (Sarvam AI: Hindi, Gujarati, English, ...) ---
SARVAM_API_KEY=
SARVAM_LANGUAGE=hi-IN
SARVAM_MODEL=saaras:v3

# --- Streaming / chunking ---
CHUNK_SECONDS=120
OVERLAP_SECONDS=10
SAMPLE_RATE=24000
CHANNELS=1
BIT_DEPTH=16

# --- Misc ---
PROMPT_VERSION=v1
CORS_ORIGINS=*
LOG_AI_JSON=true

